Enum "contract_type" {
  "ERC20"
  "ERC20_DEMURRAGE"
  "SWAPPOOL"
  "TOKEN_UNIQUE_SYMBOL_INDEX"
  "LIMITER"
  "FEE_POLICY"
  "ORACLE_QUOTER"
  "RELATIVE_QUOTER"
}

Enum "river_job_state" {
  "available"
  "cancelled"
  "completed"
  "discarded"
  "pending"
  "retryable"
  "running"
  "scheduled"
}

Enum "user_role" {
  "USER"
  "SUPERADMIN"
}

Enum "user_status" {
  "PENDING"
  "APPROVED"
  "REJECTED"
}

Table "schema_version" {
  "version" int4 [not null]
}

Table "keystore" {
  "id" int4 [pk, not null, increment]
  "public_key" text [unique, not null, check: `public_key ~ '^0x[0-9a-fA-F]{40}$'::text`]
  "private_key" text [not null]
  "active" bool [default: false]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (`lower(public_key)`) [type: btree, unique, name: "keystore_public_key_lower_key"]
  }
}

Table "master_key" {
  "id" int4 [pk, not null]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (`true`) [type: btree, unique, name: "master_key_singleton_idx"]
  }
}

Table "noncestore" {
  "keystore_id" int4 [pk, not null]
  "next_nonce" int8 [not null, check: `next_nonce >= 0`, default: 0]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table "otx_tx_type" {
  "value" text [pk, not null]
}

Table "dispatch_status_type" {
  "value" text [pk, not null]
}

Table "otx" {
  "id" int4 [pk, not null, increment]
  "tracking_id" uuid [not null]
  "otx_type" text [not null]
  "signer_account" int4 [not null]
  "raw_tx" text [not null]
  "tx_hash" text [not null]
  "nonce" int8 [not null, check: `nonce >= 0`]
  "replaced" bool [default: false]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table "dispatch" {
  "id" int4 [pk, not null, increment]
  "otx_id" int4 [unique, not null]
  "status" text [not null]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table "upgrade_meta" {
  "id" int4 [pk, not null, increment]
  "otx_id" int4 [unique, not null]
  "proxy_address" text [not null]
  "contract_type" contract_type [not null]
  "new_implementation" text [not null]
  "version" text [not null]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `(proxy_address ~ '^0x[0-9a-fA-F]{40}$'::text) AND (new_implementation ~ '^0x[0-9a-fA-F]{40}$'::text)` [name: 'upgrade_meta_address_format']
  }
}

Table "platform_contracts" {
  "id" int4 [pk, not null, increment]
  "chain_id" int4 [not null]
  "contract_type" contract_type [not null]
  "factory_address" text [not null]
  "implementation_address" text [not null]
  "version" text [not null, default: '']
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `(factory_address ~ '^0x[0-9a-fA-F]{40}$'::text) AND (implementation_address ~ '^0x[0-9a-fA-F]{40}$'::text)` [name: 'platform_contracts_address_format']
  }

  Indexes {
    (chain_id, contract_type) [type: btree, unique, name: "platform_contracts_chain_id_contract_type_key"]
  }
}

Table "deployed_tokens" {
  "id" int4 [pk, not null, increment]
  "origin_domain_id" int4 [note: 'Nullable for legacy records; immutable once assigned (migration 039 trigger).']
  "otx_id" int4 [unique, not null]
  "platform_contract_id" int4 [not null]
  "address" text [unique]
  "symbol" text [not null]
  "name" text [not null]
  "admin" text [not null]
  "description" text
  "website" text
  "email" text
  "phone" text
  "voucher_uoa" text
  "voucher_value" numeric
  "location_name" text
  "geo_lat" float8
  "geo_lng" float8
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "status" text [not null, default: 'PENDING']
  "decimals" int4 [not null, check: `(decimals >= 0) AND (decimals <= 255)`]
  "voucher_id" int4 [unique]

  Checks {
    `(address ~ '^0x[0-9a-fA-F]{40}$'::text) AND (admin ~ '^0x[0-9a-fA-F]{40}$'::text)` [name: 'deployed_tokens_address_format']
    `((geo_lat IS NULL) = (geo_lng IS NULL)) AND ((geo_lat IS NULL) OR ((geo_lat >= ('-90'::integer)::double precision) AND (geo_lat <= (90)::double precision))) AND ((geo_lng IS NULL) OR ((geo_lng >= ('-180'::integer)::double precision) AND (geo_lng <= (180)::double precision)))` [name: 'deployed_tokens_geo_valid']
    `(status <> 'CONFIRMED'::text) OR (address IS NOT NULL)` [name: 'deployed_tokens_confirmed_has_address']
  }

  Indexes {
    origin_domain_id [name: "deployed_tokens_origin_domain_idx"]
    (`lower(address)`) [type: btree, unique, name: "deployed_tokens_address_lower_key"]
  }
}

Table "token_tag" {
  "value" text [pk, not null]
}

Table "deployed_token_tags" {
  "deployed_token_id" int4 [not null]
  "tag_value" text [not null]

  Indexes {
    (deployed_token_id, tag_value) [pk, type: btree, name: "deployed_token_tags_pkey"]
  }
}

Table "protocol_addresses" {
  "id" int4 [pk, not null, increment]
  "key" text [unique, not null]
  "address" text [not null, check: `address ~ '^0x[0-9a-fA-F]{40}$'::text`]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table "deployed_pools" {
  "id" int4 [pk, not null, increment]
  "origin_domain_id" int4 [note: 'Nullable for legacy records; immutable once assigned (migration 039 trigger).']
  "otx_id" int4 [unique, not null]
  "platform_contract_id" int4 [not null]
  "address" text [unique]
  "name" text [not null]
  "symbol" text [not null]
  "token_registry_address" text [not null]
  "limiter_address" text [not null]
  "fee_policy_address" text [not null]
  "quoter_address" text [not null]
  "protocol_fee_controller_address" text [not null]
  "fees_decoupled" bool [not null, default: false]
  "admin" text [not null]
  "description" text
  "website" text
  "email" text
  "phone" text
  "location_name" text
  "geo_lat" float8
  "geo_lng" float8
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "image_url" text
  "banner_url" text
  "status" text [not null, default: 'PENDING']
  "decimals" int4 [not null, check: `(decimals >= 0) AND (decimals <= 255)`]
  "pool_id" int4 [unique]

  Checks {
    `(address ~ '^0x[0-9a-fA-F]{40}$'::text) AND (admin ~ '^0x[0-9a-fA-F]{40}$'::text) AND (token_registry_address ~ '^0x[0-9a-fA-F]{40}$'::text) AND (limiter_address ~ '^0x[0-9a-fA-F]{40}$'::text) AND (fee_policy_address ~ '^0x[0-9a-fA-F]{40}$'::text) AND (quoter_address ~ '^0x[0-9a-fA-F]{40}$'::text) AND (protocol_fee_controller_address ~ '^0x[0-9a-fA-F]{40}$'::text)` [name: 'deployed_pools_address_format']
    `((geo_lat IS NULL) = (geo_lng IS NULL)) AND ((geo_lat IS NULL) OR ((geo_lat >= ('-90'::integer)::double precision) AND (geo_lat <= (90)::double precision))) AND ((geo_lng IS NULL) OR ((geo_lng >= ('-180'::integer)::double precision) AND (geo_lng <= (180)::double precision)))` [name: 'deployed_pools_geo_valid']
    `(status <> 'CONFIRMED'::text) OR (address IS NOT NULL)` [name: 'deployed_pools_confirmed_has_address']
  }

  Indexes {
    origin_domain_id [name: "deployed_pools_origin_domain_idx"]
    (`lower(address)`) [type: btree, unique, name: "deployed_pools_address_lower_key"]
  }
}

Table "deployed_pool_tags" {
  "deployed_pool_id" int4 [not null]
  "tag_value" text [not null]

  Indexes {
    (deployed_pool_id, tag_value) [pk, type: btree, name: "deployed_pool_tags_pkey"]
  }
}

Table "oracle_feeds" {
  "id" int4 [pk, not null, increment]
  "name" text [unique, not null]
  "address" text [not null, check: `address ~ '^0x[0-9a-fA-F]{40}$'::text`]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table "users" {
  "registration_domain_id" int4 [note: 'Assigned once at domain onboarding; not current browsing space.']
  "domain_revision" int8 [not null, default: 0, check: `domain_revision >= 0`]
  "id" int4 [pk, not null, increment]
  "blockchain_address" text [unique, not null, check: `blockchain_address ~ '^0x[0-9a-fA-F]{40}$'::text`]
  "name" text [not null]
  "email" text [unique]
  "phone" text [unique]
  "country" text [not null, default: '']
  "role" user_role [not null, default: 'USER']
  "status" user_status [not null, default: 'PENDING']
  "max_pools" int4 [not null, default: 10]
  "max_tokens" int4 [not null, default: 20]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "default_voucher_id" int4

  Checks {
    `(email IS NOT NULL) OR (phone IS NOT NULL)` [name: 'users_at_least_one_contact']
    `(max_pools >= 0) AND (max_tokens >= 0)` [name: 'users_quotas_nonneg']
  }

  Indexes {
    registration_domain_id [name: "users_registration_domain_idx", note: 'Partial: registration_domain_id IS NOT NULL.']
    (`lower(blockchain_address)`) [type: btree, unique, name: "users_blockchain_address_lower_key"]
    status [type: btree, name: "users_status_idx"]
  }
}

Table "user_deployments" {
  "id" int4 [pk, not null, increment]
  "user_id" int4 [not null]
  "tracking_id" uuid [unique, not null]
  "resource_type" text [not null, check: `resource_type = ANY (ARRAY['TOKEN'::text, 'POOL'::text])`]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    user_id [type: btree, name: "user_deployments_user_id_idx"]
  }
}

Table "webauthn_credentials" {
  "credential_id" text [pk, not null]
  "address" text [not null, check: `address ~ '^0x[0-9a-fA-F]{40}$'::text`]
  "key_hash" text [not null]
  "public_key_x" numeric [not null]
  "public_key_y" numeric [not null]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    address [type: btree, name: "webauthn_credentials_address_idx"]
  }
}

Table "deploy_status_type" {
  "value" text [pk, not null]
}

Table "voucher_type" {
  "value" text [pk, not null]
}

Table "vouchers" {
  "id" int4 [pk, not null, increment]
  "origin_domain_id" int4 [note: 'Nullable for legacy records; immutable once assigned (migration 039 trigger).']
  "chain_id" int4 [not null]
  "address" text [not null]
  "name" text
  "display_name" text
  "symbol" text
  "decimals" int4
  "owner_address" text
  "voucher_type" text
  "sink_address" text
  "redemption_address" text
  "description" text
  "voucher_uoa" text
  "voucher_value" numeric
  "location_name" text
  "geo_lat" float8
  "geo_lng" float8
  "email" text
  "website" text
  "phone" text
  "icon_url" text
  "banner_url" text
  "terms" text
  "contract_version" text
  "active" bool [not null, default: true]
  "internal" bool [not null, default: false]
  "platform_contract_id" int4
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `address ~ '^0x[0-9a-fA-F]{40}$'::text` [name: 'vouchers_address_format']
    `owner_address IS NULL OR owner_address ~ '^0x[0-9a-fA-F]{40}$'::text` [name: 'vouchers_owner_format']
    `sink_address IS NULL OR sink_address ~ '^0x[0-9a-fA-F]{40}$'::text` [name: 'vouchers_sink_format']
    `redemption_address IS NULL OR redemption_address ~ '^0x[0-9a-fA-F]{40}$'::text` [name: 'vouchers_redemption_format']
    `decimals IS NULL OR decimals BETWEEN 0 AND 255` [name: 'vouchers_decimals_range']
    `voucher_value IS NULL OR voucher_value >= 0` [name: 'vouchers_value_nonneg']
    `display_name IS NULL OR (display_name = btrim(display_name) AND char_length(display_name) BETWEEN 1 AND 120)` [name: 'vouchers_display_name_valid']
    `((geo_lat IS NULL) = (geo_lng IS NULL)) AND (geo_lat IS NULL OR geo_lat BETWEEN -90 AND 90) AND (geo_lng IS NULL OR geo_lng BETWEEN -180 AND 180)` [name: 'vouchers_geo_valid']
  }

  Indexes {
    (origin_domain_id, id) [name: "vouchers_origin_domain_id_idx"]
    (chain_id, address) [type: btree, unique, name: "vouchers_chain_id_address_key"]
    (chain_id, `lower(address)`) [type: btree, unique, name: "vouchers_chain_address_lower_key"]
  }
}

Table "voucher_tags" {
  "voucher_id" int4 [not null]
  "tag_value" text [not null]

  Indexes {
    (voucher_id, tag_value) [pk, type: btree, name: "voucher_tags_pkey"]
  }
}

Table "pools" {
  "id" int4 [pk, not null, increment]
  "origin_domain_id" int4 [note: 'Nullable for legacy records; immutable once assigned (migration 039 trigger).']
  "chain_id" int4 [not null]
  "address" text [not null]
  "name" text
  "symbol" text
  "owner_address" text
  "fee_ppm" numeric
  "fee_address" text
  "token_registry_address" text
  "limiter_address" text
  "quoter_address" text
  "fee_policy_address" text
  "protocol_fee_controller_address" text
  "fees_decoupled" bool
  "decimals" int4
  "description" text
  "unit_of_account" text
  "location_name" text
  "geo_lat" float8
  "geo_lng" float8
  "email" text
  "website" text
  "phone" text
  "image_url" text
  "banner_url" text
  "terms" text
  "default_voucher_id" int4
  "platform_contract_id" int4
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `address ~ '^0x[0-9a-fA-F]{40}$'::text` [name: 'pools_address_format']
    `owner_address IS NULL OR owner_address ~ '^0x[0-9a-fA-F]{40}$'::text` [name: 'pools_owner_format']
    `fee_address IS NULL OR fee_address ~ '^0x[0-9a-fA-F]{40}$'::text` [name: 'pools_fee_address_format']
    `token_registry_address IS NULL OR token_registry_address ~ '^0x[0-9a-fA-F]{40}$'::text` [name: 'pools_token_registry_format']
    `limiter_address IS NULL OR limiter_address ~ '^0x[0-9a-fA-F]{40}$'::text` [name: 'pools_limiter_format']
    `quoter_address IS NULL OR quoter_address ~ '^0x[0-9a-fA-F]{40}$'::text` [name: 'pools_quoter_format']
    `fee_policy_address IS NULL OR fee_policy_address ~ '^0x[0-9a-fA-F]{40}$'::text` [name: 'pools_fee_policy_format']
    `protocol_fee_controller_address IS NULL OR protocol_fee_controller_address ~ '^0x[0-9a-fA-F]{40}$'::text` [name: 'pools_protocol_fee_controller_format']
    `fee_ppm IS NULL OR fee_ppm BETWEEN 0 AND 1000000` [name: 'pools_fee_ppm_range']
    `decimals IS NULL OR decimals BETWEEN 0 AND 255` [name: 'pools_decimals_range']
    `((geo_lat IS NULL) = (geo_lng IS NULL)) AND (geo_lat IS NULL OR geo_lat BETWEEN -90 AND 90) AND (geo_lng IS NULL OR geo_lng BETWEEN -180 AND 180)` [name: 'pools_geo_valid']
  }

  Indexes {
    (origin_domain_id, id) [name: "pools_origin_domain_id_idx"]
    (chain_id, address) [type: btree, unique, name: "pools_chain_id_address_key"]
    (chain_id, `lower(address)`) [type: btree, unique, name: "pools_chain_address_lower_key"]
  }
}

Table "pool_tags" {
  "pool_id" int4 [not null]
  "tag_value" text [not null]

  Indexes {
    (pool_id, tag_value) [pk, type: btree, name: "pool_tags_pkey"]
  }
}

Table "pool_tokens" {
  "pool_id" int4 [not null]
  "voucher_id" int4 [not null]
  "is_allowed" bool [not null, default: true]
  "exchange_rate" numeric
  "token_limit" numeric
  "synced_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `exchange_rate IS NULL OR exchange_rate >= 0` [name: 'pool_tokens_rate_nonneg']
    `token_limit IS NULL OR token_limit >= 0` [name: 'pool_tokens_limit_nonneg']
  }

  Indexes {
    (pool_id, voucher_id) [pk, type: btree, name: "pool_tokens_pkey"]
    voucher_id [type: btree, name: "pool_tokens_voucher_id_idx"]
  }
}

Table "report_status_type" {
  "value" text [pk, not null]
}

Table "reports" {
  "id" int4 [pk, not null, increment]
  "origin_domain_id" int4 [note: 'Nullable for legacy records; immutable once assigned (migration 039 trigger).']
  "source_id" int4 [unique]
  "title" text [not null]
  "body" jsonb [not null]
  "description" text [not null, default: '']
  "image_url" text
  "location_name" text
  "geo_lat" float8
  "geo_lng" float8
  "period_from" timestamptz
  "period_to" timestamptz
  "author_address" text [not null]
  "modifier_address" text
  "status" text [not null, default: 'DRAFT']
  "rejection_reason" text
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `author_address ~ '^0x[0-9a-fA-F]{40}$'::text` [name: 'reports_author_format']
    `modifier_address IS NULL OR modifier_address ~ '^0x[0-9a-fA-F]{40}$'::text` [name: 'reports_modifier_format']
    `((geo_lat IS NULL) = (geo_lng IS NULL)) AND (geo_lat IS NULL OR geo_lat BETWEEN -90 AND 90) AND (geo_lng IS NULL OR geo_lng BETWEEN -180 AND 180)` [name: 'reports_geo_valid']
    `period_from IS NULL OR period_to IS NULL OR period_from <= period_to` [name: 'reports_period_valid']
    `status <> 'REJECTED' OR (rejection_reason IS NOT NULL AND btrim(rejection_reason) <> '')` [name: 'reports_rejection_when_rejected']
    `status = 'REJECTED' OR rejection_reason IS NULL` [name: 'reports_rejection_only_if_rejected']
  }

  Indexes {
    (origin_domain_id, id) [name: "reports_origin_domain_id_idx"]
    (origin_domain_id, updated_at, id) [name: "reports_origin_domain_feed_idx", note: 'Partial: status = APPROVED; updated_at and id descending.']
    (status, created_at, id) [type: btree, name: "reports_status_created_idx"]
    (author_address, created_at, id) [type: btree, name: "reports_author_created_idx"]
  }
}

Table "report_vouchers" {
  "report_id" int4 [not null]
  "voucher_id" int4 [not null]

  Indexes {
    (report_id, voucher_id) [pk, type: btree, name: "report_vouchers_pkey"]
    voucher_id [type: btree, name: "report_vouchers_voucher_id_idx"]
  }
}

Table "report_tags" {
  "report_id" int4 [not null]
  "tag_value" text [not null]

  Indexes {
    (report_id, tag_value) [pk, type: btree, name: "report_tags_pkey"]
  }
}

Table "report_verifiers" {
  "report_id" int4 [not null]
  "verifier_address" text [not null]

  Checks {
    `verifier_address ~ '^0x[0-9a-fA-F]{40}$'::text` [name: 'report_verifiers_address_format']
  }

  Indexes {
    (report_id, verifier_address) [pk, type: btree, name: "report_verifiers_pkey"]
  }
}

Table "commodity_type" {
  "value" text [pk, not null]
}

Table "offering_frequency" {
  "value" text [pk, not null]
}

Table "offerings" {
  "id" int4 [pk, not null, increment]
  "source_id" int4 [unique]
  "voucher_id" int4 [not null]
  "seller_address" text [not null]
  "commodity_name" text [not null]
  "commodity_type" text [not null]
  "description" text [not null, default: '']
  "quantity" numeric [not null]
  "unit" text
  "frequency" text
  "price" numeric
  "available" bool [not null, default: true]
  "location_name" text
  "geo_lat" float8
  "geo_lng" float8
  "image_url" text
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `seller_address ~ '^0x[0-9a-fA-F]{40}$'::text` [name: 'offerings_seller_format']
    `price IS NULL OR price >= 0` [name: 'offerings_price_nonneg']
    `quantity >= 0` [name: 'offerings_quantity_nonneg']
    `((geo_lat IS NULL) = (geo_lng IS NULL)) AND (geo_lat IS NULL OR geo_lat BETWEEN -90 AND 90) AND (geo_lng IS NULL OR geo_lng BETWEEN -180 AND 180)` [name: 'offerings_geo_valid']
  }

  Indexes {
    voucher_id [type: btree, name: "offerings_voucher_id_idx"]
    (seller_address, created_at, id) [type: btree, name: "offerings_seller_created_idx"]
    (available, created_at, id) [type: btree, name: "offerings_available_created_idx"]
    (commodity_type, available, created_at, id) [type: btree, name: "offerings_type_available_idx"]
  }
}

Table "offering_tags" {
  "offering_id" int4 [not null]
  "tag_value" text [not null]

  Indexes {
    (offering_id, tag_value) [pk, type: btree, name: "offering_tags_pkey"]
  }
}

Table "river_job" {
  "id" int8 [pk, not null, increment]
  "state" river_job_state [not null, default: 'available']
  "attempt" int2 [not null, default: 0]
  "max_attempts" int2 [not null, check: `max_attempts > 0`]
  "attempted_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "finalized_at" timestamptz
  "scheduled_at" timestamptz [not null, default: `now()`]
  "priority" int2 [not null, check: `(priority >= 1) AND (priority <= 4)`, default: 1]
  "args" jsonb [not null]
  "attempted_by" "text[]"
  "errors" "jsonb[]"
  "kind" text [not null, check: `(char_length(kind) > 0) AND (char_length(kind) < 128)`]
  "metadata" jsonb [not null, default: `'{}'::jsonb`]
  "queue" text [not null, check: `(char_length(queue) > 0) AND (char_length(queue) < 128)`, default: 'default']
  "tags" "varchar[]" [not null, default: `'{}'::character varying[]`]
  "unique_key" bytea [unique]
  "unique_states" bit(8)

  Checks {
    `((finalized_at IS NULL) AND (state <> ALL (ARRAY['cancelled'::river_job_state, 'completed'::river_job_state, 'discarded'::river_job_state]))) OR ((finalized_at IS NOT NULL) AND (state = ANY (ARRAY['cancelled'::river_job_state, 'completed'::river_job_state, 'discarded'::river_job_state])))` [name: 'finalized_or_finalized_at_null']
  }

  Indexes {
    args [type: gin, name: "river_job_args_index"]
    kind [type: btree, name: "river_job_kind"]
    metadata [type: gin, name: "river_job_metadata_index"]
    (state, queue, priority, scheduled_at, id) [type: btree, name: "river_job_prioritized_fetching_index"]
    (state, finalized_at) [type: btree, name: "river_job_state_and_finalized_at_index"]
  }
}

Table "river_leader" {
  "elected_at" timestamptz [not null]
  "expires_at" timestamptz [not null]
  "leader_id" text [not null, check: `(char_length(leader_id) > 0) AND (char_length(leader_id) < 128)`]
  "name" text [pk, not null, check: `name = 'default'::text`, default: 'default']
}

Table "river_queue" {
  "name" text [pk, not null]
  "created_at" timestamptz [not null, default: `now()`]
  "metadata" jsonb [not null, default: `'{}'::jsonb`]
  "paused_at" timestamptz
  "updated_at" timestamptz [not null]
}

Table "river_migration" {
  "line" text [not null, check: `(char_length(line) > 0) AND (char_length(line) < 128)`]
  "version" int8 [not null, check: `version >= 1`]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (line, version) [pk, type: btree, name: "river_migration_pkey1"]
  }
}

Table "river_client" {
  "id" text [pk, not null, check: `(char_length(id) > 0) AND (char_length(id) < 128)`]
  "created_at" timestamptz [not null, default: `now()`]
  "metadata" jsonb [not null, default: `'{}'::jsonb`]
  "paused_at" timestamptz
  "updated_at" timestamptz [not null]
}

Table "river_client_queue" {
  "river_client_id" text [not null]
  "name" text [not null, check: `(char_length(name) > 0) AND (char_length(name) < 128)`]
  "created_at" timestamptz [not null, default: `now()`]
  "max_workers" int8 [not null, default: 0]
  "metadata" jsonb [not null, default: `'{}'::jsonb`]
  "num_jobs_completed" int8 [not null, check: `num_jobs_completed >= 0`, default: 0]
  "num_jobs_running" int8 [not null, check: `num_jobs_running >= 0`, default: 0]
  "updated_at" timestamptz [not null]

  Indexes {
    (river_client_id, name) [pk, type: btree, name: "river_client_queue_pkey"]
  }
}

