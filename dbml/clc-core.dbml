// Domain foundation (migration 039). No membership or catalog API is enabled yet.
Table "domains" {
  "id" int4 [pk, not null, increment]
  "slug" text [unique, not null, note: 'Lowercase ASCII slug, at most 63 characters; editable without changing space ID.']
  "name" text [not null, check: `btrim(name) <> ''`]
  "description" text [not null, default: '']
  "is_global" bool [not null, default: false, note: 'Identifies the protected global Sarafu space.']
  "status" text [not null, default: 'active', check: `status IN ('active', 'archived')`]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  Indexes {
    is_global [unique, name: 'domains_one_global_key', note: 'Partial: is_global.']
  }
  Note: 'Triggers prevent changing Sarafu identity, archiving/deleting it, while allowing slug renaming.'
}

Table "domain_hosts" {
  "id" int4 [pk, not null, increment]
  "domain_id" int4 [unique, not null]
  "hostname" text [unique, not null, note: 'Normalized ASCII/IDNA DNS name without scheme, port or trailing dot; immutable mapping.']
  "status" text [not null, default: 'pending', check: `status IN ('pending', 'verified', 'active', 'disabled')`]
  "verified_at" timestamptz
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  Checks {
    `status NOT IN ('verified', 'active') OR verified_at IS NOT NULL` [name: 'domain_hosts_verified_state']
  }
}

Table "user_domains" {
  "user_id" int4 [not null]
  "domain_id" int4 [not null]
  "status" text [not null, default: 'active', check: `status IN ('active', 'left', 'suspended')`]
  "joined_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "left_at" timestamptz
  Checks {
    `(status = 'left') = (left_at IS NOT NULL) AND (left_at IS NULL OR left_at >= joined_at)` [name: 'user_domains_left_at_valid']
  }
  Indexes {
    (user_id, domain_id) [pk]
    (domain_id, user_id) [name: 'user_domains_active_domain_idx', note: 'Partial: status = active.']
  }
}

Table "domain_audit_events" {
  "id" int8 [pk, not null, increment]
  "domain_id" int4 [not null]
  "actor_key" text [not null, check: `btrim(actor_key) <> ''`]
  "action" text [not null, check: `btrim(action) <> ''`]
  "entity_type" text [not null, check: `btrim(entity_type) <> ''`]
  "entity_key" text [not null, check: `btrim(entity_key) <> ''`]
  "before_state" jsonb [note: 'SQL NULL or an object of at most 16384 bytes serialized as text.']
  "after_state" jsonb [note: 'SQL NULL or an object of at most 16384 bytes serialized as text.']
  "reason" text [not null, default: '']
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  Indexes {
    (domain_id, created_at, id) [name: 'domain_audit_events_domain_created_idx', note: 'created_at and id descending.']
  }
}

