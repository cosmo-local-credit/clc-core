Enum "contract_type" {
  "ERC20"
  "ERC20_DEMURRAGE"
  "SWAPPOOL"
  "TOKEN_UNIQUE_SYMBOL_INDEX"
  "LIMITER"
  "FEE_POLICY"
  "ORACLE_QUOTER"
  "RELATIVE_QUOTER"
}

Enum "river_job_state" {
  "available"
  "cancelled"
  "completed"
  "discarded"
  "pending"
  "retryable"
  "running"
  "scheduled"
}

Enum "user_role" {
  "USER"
  "SUPERADMIN"
}

Enum "user_status" {
  "PENDING"
  "APPROVED"
  "REJECTED"
}

Table "schema_version" {
  "version" int4 [not null]
}

Table "keystore" {
  "id" int4 [pk, not null, increment]
  "public_key" text [unique, not null]
  "private_key" text [not null]
  "active" bool [default: false]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `public_key ~ '^0x[0-9a-fA-F]{40}$'` [name: 'keystore_public_key_format']
  }

  Indexes {
    `lower(public_key)` [type: btree, unique, name: "keystore_public_key_lower_key"]
  }
}

Table "master_key" {
  "id" int4 [pk, not null]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    `(true)` [type: btree, unique, name: "master_key_singleton_idx"]
  }
}

Table "noncestore" {
  "keystore_id" int4 [pk, not null]
  "next_nonce" int8 [not null, default: 0]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `next_nonce >= 0` [name: 'noncestore_next_nonce_nonneg']
  }
}

Table "otx_tx_type" {
  "value" text [pk, not null]
}

Table "dispatch_status_type" {
  "value" text [pk, not null]
}

Table "otx" {
  "id" int4 [pk, not null, increment]
  "tracking_id" uuid [not null]
  "otx_type" text [not null]
  "signer_account" int4 [not null]
  "raw_tx" text [not null]
  "tx_hash" text [not null]
  "nonce" int8 [not null]
  "replaced" bool [default: false]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `nonce >= 0` [name: 'otx_nonce_nonneg']
  }
}

Table "dispatch" {
  "id" int4 [pk, not null, increment]
  "otx_id" int4 [unique, not null]
  "status" text [not null]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table "upgrade_meta" {
  "id" int4 [pk, not null, increment]
  "otx_id" int4 [unique, not null]
  "proxy_address" text [not null]
  "contract_type" contract_type [not null]
  "new_implementation" text [not null]
  "version" text [not null]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `proxy_address ~ '^0x[0-9a-fA-F]{40}$' AND new_implementation ~ '^0x[0-9a-fA-F]{40}$'` [name: 'upgrade_meta_address_format']
  }
}

Table "platform_contracts" {
  "id" int4 [pk, not null, increment]
  "chain_id" int4 [not null]
  "contract_type" contract_type [not null]
  "factory_address" text [not null]
  "implementation_address" text [not null]
  "version" text [not null, default: '']
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `factory_address ~ '^0x[0-9a-fA-F]{40}$' AND implementation_address ~ '^0x[0-9a-fA-F]{40}$'` [name: 'platform_contracts_address_format']
  }

  Indexes {
    (chain_id, contract_type) [type: btree, unique, name: "platform_contracts_chain_id_contract_type_key"]
  }
}

Table "deployed_tokens" {
  "id" int4 [pk, not null, increment]
  "otx_id" int4 [unique, not null]
  "platform_contract_id" int4 [not null]
  "address" text [unique]
  "symbol" text [not null]
  "name" text [not null]
  "admin" text [not null]
  "description" text
  "website" text
  "email" text
  "phone" text
  "voucher_uoa" text
  "voucher_value" numeric
  "location_name" text
  "geo_lat" float8
  "geo_lng" float8
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "status" text [not null, default: 'PENDING']
  "decimals" int4 [not null]

  Checks {
    `address ~ '^0x[0-9a-fA-F]{40}$' AND admin ~ '^0x[0-9a-fA-F]{40}$'` [name: 'deployed_tokens_address_format']
    `((geo_lat IS NULL) = (geo_lng IS NULL)) AND (geo_lat IS NULL OR geo_lat BETWEEN -90 AND 90) AND (geo_lng IS NULL OR geo_lng BETWEEN -180 AND 180)` [name: 'deployed_tokens_geo_valid']
    `decimals BETWEEN 0 AND 255` [name: 'deployed_tokens_decimals_range']
    `status <> 'CONFIRMED' OR address IS NOT NULL` [name: 'deployed_tokens_confirmed_has_address']
  }

  Indexes {
    `lower(address)` [type: btree, unique, name: "deployed_tokens_address_lower_key"]
  }
}

Table "token_tag" {
  "value" text [pk, not null]
}

Table "deployed_token_tags" {
  "deployed_token_id" int4 [not null]
  "tag_value" text [not null]

  Indexes {
    (deployed_token_id, tag_value) [pk, type: btree, name: "deployed_token_tags_pkey"]
  }
}

Table "pool_addresses" {
  "id" int4 [pk, not null, increment]
  "key" text [unique, not null]
  "address" text [not null]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `address ~ '^0x[0-9a-fA-F]{40}$'` [name: 'pool_addresses_address_format']
  }
}

Table "deployed_pools" {
  "id" int4 [pk, not null, increment]
  "otx_id" int4 [unique, not null]
  "platform_contract_id" int4 [not null]
  "address" text [unique]
  "name" text [not null]
  "symbol" text [not null]
  "token_registry_address" text [not null]
  "limiter_address" text [not null]
  "fee_policy_address" text [not null]
  "quoter_address" text [not null]
  "protocol_fee_controller_address" text [not null]
  "fees_decoupled" bool [not null, default: false]
  "admin" text [not null]
  "description" text
  "website" text
  "email" text
  "phone" text
  "location_name" text
  "geo_lat" float8
  "geo_lng" float8
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "image_url" text
  "banner_url" text
  "status" text [not null, default: 'PENDING']
  "decimals" int4 [not null]

  Checks {
    `address ~ '^0x[0-9a-fA-F]{40}$' AND admin ~ '^0x[0-9a-fA-F]{40}$' AND token_registry_address ~ '^0x[0-9a-fA-F]{40}$' AND limiter_address ~ '^0x[0-9a-fA-F]{40}$' AND fee_policy_address ~ '^0x[0-9a-fA-F]{40}$' AND quoter_address ~ '^0x[0-9a-fA-F]{40}$' AND protocol_fee_controller_address ~ '^0x[0-9a-fA-F]{40}$'` [name: 'deployed_pools_address_format']
    `((geo_lat IS NULL) = (geo_lng IS NULL)) AND (geo_lat IS NULL OR geo_lat BETWEEN -90 AND 90) AND (geo_lng IS NULL OR geo_lng BETWEEN -180 AND 180)` [name: 'deployed_pools_geo_valid']
    `decimals BETWEEN 0 AND 255` [name: 'deployed_pools_decimals_range']
    `status <> 'CONFIRMED' OR address IS NOT NULL` [name: 'deployed_pools_confirmed_has_address']
  }

  Indexes {
    `lower(address)` [type: btree, unique, name: "deployed_pools_address_lower_key"]
  }
}

Table "deployed_pool_tags" {
  "deployed_pool_id" int4 [not null]
  "tag_value" text [not null]

  Indexes {
    (deployed_pool_id, tag_value) [pk, type: btree, name: "deployed_pool_tags_pkey"]
  }
}

Table "oracle_feeds" {
  "id" int4 [pk, not null, increment]
  "name" text [unique, not null]
  "address" text [not null]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `address ~ '^0x[0-9a-fA-F]{40}$'` [name: 'oracle_feeds_address_format']
  }
}

Table "users" {
  "id" int4 [pk, not null, increment]
  "blockchain_address" text [unique, not null]
  "name" text [not null]
  "email" text [unique]
  "phone" text [unique]
  "country" text [not null, default: '']
  "role" user_role [not null, default: 'USER']
  "status" user_status [not null, default: 'PENDING']
  "max_pools" int4 [not null, default: 10]
  "max_tokens" int4 [not null, default: 20]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `(email IS NOT NULL) OR (phone IS NOT NULL)` [name: 'users_at_least_one_contact']
    `blockchain_address ~ '^0x[0-9a-fA-F]{40}$'` [name: 'users_blockchain_address_format']
    `max_pools >= 0 AND max_tokens >= 0` [name: 'users_quotas_nonneg']
  }

  Indexes {
    `lower(blockchain_address)` [type: btree, unique, name: "users_blockchain_address_lower_key"]
    status [type: btree, name: "users_status_idx"]
  }
}

Table "user_deployments" {
  "id" int4 [pk, not null, increment]
  "user_id" int4 [not null]
  "tracking_id" uuid [unique, not null]
  "resource_type" text [not null, check: `resource_type = ANY (ARRAY['TOKEN'::text, 'POOL'::text])`]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    user_id [type: btree, name: "user_deployments_user_id_idx"]
  }
}

Table "webauthn_credentials" {
  "credential_id" text [pk, not null]
  "address" text [not null]
  "key_hash" text [not null]
  "public_key_x" numeric [not null]
  "public_key_y" numeric [not null]
  "created_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `address ~ '^0x[0-9a-fA-F]{40}$'` [name: 'webauthn_address_format']
  }

  Indexes {
    address [type: btree, name: "webauthn_credentials_address_idx"]
  }
}

Table "river_job" {
  "id" int8 [pk, not null, increment]
  "state" river_job_state [not null, default: 'available']
  "attempt" int2 [not null, default: 0]
  "max_attempts" int2 [not null, check: `max_attempts > 0`]
  "attempted_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "finalized_at" timestamptz
  "scheduled_at" timestamptz [not null, default: `now()`]
  "priority" int2 [not null, check: `(priority >= 1) AND (priority <= 4)`, default: 1]
  "args" jsonb [not null]
  "attempted_by" "text[]"
  "errors" "jsonb[]"
  "kind" text [not null, check: `(char_length(kind) > 0) AND (char_length(kind) < 128)`]
  "metadata" jsonb [not null, default: `'{}'::jsonb`]
  "queue" text [not null, check: `(char_length(queue) > 0) AND (char_length(queue) < 128)`, default: 'default']
  "tags" "varchar[]" [not null, default: `'{}'::character varying[]`]
  "unique_key" bytea [unique]
  "unique_states" bit(8)

  Checks {
    `((finalized_at IS NULL) AND (state <> ALL (ARRAY['cancelled'::river_job_state, 'completed'::river_job_state, 'discarded'::river_job_state]))) OR ((finalized_at IS NOT NULL) AND (state = ANY (ARRAY['cancelled'::river_job_state, 'completed'::river_job_state, 'discarded'::river_job_state])))` [name: 'finalized_or_finalized_at_null']
  }

  Indexes {
    args [type: gin, name: "river_job_args_index"]
    kind [type: btree, name: "river_job_kind"]
    metadata [type: gin, name: "river_job_metadata_index"]
    (state, queue, priority, scheduled_at, id) [type: btree, name: "river_job_prioritized_fetching_index"]
    (state, finalized_at) [type: btree, name: "river_job_state_and_finalized_at_index"]
  }
}

Table "river_leader" {
  "elected_at" timestamptz [not null]
  "expires_at" timestamptz [not null]
  "leader_id" text [not null, check: `(char_length(leader_id) > 0) AND (char_length(leader_id) < 128)`]
  "name" text [pk, not null, check: `name = 'default'::text`, default: 'default']
}

Table "river_queue" {
  "name" text [pk, not null]
  "created_at" timestamptz [not null, default: `now()`]
  "metadata" jsonb [not null, default: `'{}'::jsonb`]
  "paused_at" timestamptz
  "updated_at" timestamptz [not null]
}

Table "river_migration" {
  "line" text [not null, check: `(char_length(line) > 0) AND (char_length(line) < 128)`]
  "version" int8 [not null, check: `version >= 1`]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (line, version) [pk, type: btree, name: "river_migration_pkey1"]
  }
}

Table "river_client" {
  "id" text [pk, not null, check: `(char_length(id) > 0) AND (char_length(id) < 128)`]
  "created_at" timestamptz [not null, default: `now()`]
  "metadata" jsonb [not null, default: `'{}'::jsonb`]
  "paused_at" timestamptz
  "updated_at" timestamptz [not null]
}

Table "river_client_queue" {
  "river_client_id" text [not null]
  "name" text [not null, check: `(char_length(name) > 0) AND (char_length(name) < 128)`]
  "created_at" timestamptz [not null, default: `now()`]
  "max_workers" int8 [not null, default: 0]
  "metadata" jsonb [not null, default: `'{}'::jsonb`]
  "num_jobs_completed" int8 [not null, check: `num_jobs_completed >= 0`, default: 0]
  "num_jobs_running" int8 [not null, check: `num_jobs_running >= 0`, default: 0]
  "updated_at" timestamptz [not null]

  Indexes {
    (river_client_id, name) [pk, type: btree, name: "river_client_queue_pkey"]
  }
}

Table "deploy_status_type" {
  "value" text [pk, not null]
}

Ref "deployed_pool_tags_deployed_pool_id_fkey":"deployed_pools"."id" < "deployed_pool_tags"."deployed_pool_id" [delete: cascade]

Ref "deployed_pool_tags_tag_value_fkey":"token_tag"."value" < "deployed_pool_tags"."tag_value"

Ref "deployed_pools_otx_id_fkey":"otx"."id" < "deployed_pools"."otx_id"

Ref "deployed_pools_platform_contract_id_fkey":"platform_contracts"."id" < "deployed_pools"."platform_contract_id"

Ref "deployed_pools_status_fkey":"deploy_status_type"."value" < "deployed_pools"."status"

Ref "deployed_token_tags_deployed_token_id_fkey":"deployed_tokens"."id" < "deployed_token_tags"."deployed_token_id" [delete: cascade]

Ref "deployed_token_tags_tag_value_fkey":"token_tag"."value" < "deployed_token_tags"."tag_value"

Ref "deployed_tokens_otx_id_fkey":"otx"."id" < "deployed_tokens"."otx_id"

Ref "deployed_tokens_platform_contract_id_fkey":"platform_contracts"."id" < "deployed_tokens"."platform_contract_id"

Ref "deployed_tokens_status_fkey":"deploy_status_type"."value" < "deployed_tokens"."status"

Ref "dispatch_otx_id_fkey":"otx"."id" < "dispatch"."otx_id"

Ref "dispatch_status_fkey":"dispatch_status_type"."value" < "dispatch"."status"

Ref "master_key_id_fkey":"keystore"."id" < "master_key"."id"

Ref "noncestore_keystore_id_fkey":"keystore"."id" < "noncestore"."keystore_id"

Ref "otx_otx_type_fkey":"otx_tx_type"."value" < "otx"."otx_type"

Ref "otx_signer_account_fkey":"keystore"."id" < "otx"."signer_account"

Ref "river_client_queue_river_client_id_fkey":"river_client"."id" < "river_client_queue"."river_client_id" [delete: cascade]

Ref "upgrade_meta_otx_id_fkey":"otx"."id" < "upgrade_meta"."otx_id"

Ref "user_deployments_user_id_fkey":"users"."id" < "user_deployments"."user_id" [delete: cascade]
